    {
      "id": "SXK5TKeinIYZMXuY-spBs",
      "type": "text",
      "x": -759.5,
      "y": 272.9765625,
      "width": 717.84521484375,
      "height": 297.2226118607957,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1gId4F29cyd4Ll6m53ktW"
      ],
      "frameId": null,
      "index": "b4b",
      "roundness": null,
      "seed": 14686579,
      "version": 924,
      "versionNonce": 1154177203,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760539085210,
      "link": null,
      "locked": false,
      "text": "                                It removes the initial hurdle for beginners who don't \nhave any ETH to start using the blockchain.\n\n                                     Applications can sponsor transactions to attract\nmore users by abstracting away the complexity and cost of gas.\n\n                                    It allows a \"sponsor\" to accept payment for gas in\nother tokens, like USDC, instead of requiring ETH.\n\n                          Users can maintain anonymity by having a separate, \nunlinked account cover the gas costs for transactions from a fresh wallet\n\n",
      "fontSize": 18.29062226835666,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                                It removes the initial hurdle for beginners who don't \nhave any ETH to start using the blockchain.\n\n                                     Applications can sponsor transactions to attract\nmore users by abstracting away the complexity and cost of gas.\n\n                                    It allows a \"sponsor\" to accept payment for gas in\nother tokens, like USDC, instead of requiring ETH.\n\n                          Users can maintain anonymity by having a separate, \nunlinked account cover the gas costs for transactions from a fresh wallet\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
