      "seed": 16402985,
      "version": 1313,
      "versionNonce": 860881703,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760388846435,
      "link": null,
      "locked": false,
      "text": "\nIt's forbidden from using banned opcodes (like TIMESTAMP) that \ncould change its outcome based on when it's executed.\n \nAdditionally, it's restricted to only accessing \"associated storage,\" \nwhich means it can only touch its own data or storage slots \nin other contracts that are specifically linked to the wallet's address.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nIt's forbidden from using banned opcodes (like TIMESTAMP) that \ncould change its outcome based on when it's executed.\n \nAdditionally, it's restricted to only accessing \"associated storage,\" \nwhich means it can only touch its own data or storage slots \nin other contracts that are specifically linked to the wallet's address.",
      "autoResize": true,
      "lineHeight": 1.25
    },
