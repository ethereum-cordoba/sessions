      "isDeleted": false,
      "boundElements": [],
      "updated": 1760389081011,
      "link": null,
      "locked": false,
      "text": "Entry point first uses the wallet's pre-deposited funds to pay for gas. \nIf that deposit is insufficient, it will request the remaining balance \ndirectly from the wallet during the validateOp call.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entry point first uses the wallet's pre-deposited funds to pay for gas. \nIf that deposit is insufficient, it will request the remaining balance \ndirectly from the wallet during the validateOp call.",
      "autoResize": false,
      "lineHeight": 1.25
    },
