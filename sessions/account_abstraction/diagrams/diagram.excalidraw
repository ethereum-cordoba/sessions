      "isDeleted": false,
      "boundElements": [],
      "updated": 1760387908661,
      "link": null,
      "locked": false,
      "text": "\n             first checks if the wallet has sufficient funds to cover \nthe maximum potential gas cost, rejecting the operation if it doesn't. \nThen, it calls the wallet's               function, measures the actual gas used, \nand finally reimburses the entity that paid the gas (the executor) from the \nwallet's ETH balance.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n             first checks if the wallet has sufficient funds to cover \nthe maximum potential gas cost, rejecting the operation if it doesn't. \nThen, it calls the wallet's               function, measures the actual gas used, \nand finally reimburses the entity that paid the gas (the executor) from the \nwallet's ETH balance.",
      "autoResize": true,
      "lineHeight": 1.25
    },
